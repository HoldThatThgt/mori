{
  "name": "mori",
  "productName": "Mori",
  "version": "0.0.1",
  "private": true,
  "description": "Mori desktop app",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "fake-endpoint": "node tests/fake-endpoint/server.mjs",
    "dist": "npm run check && electron-vite build && electron-builder --win nsis --publish never",
    "dist:dir": "npm run check && electron-vite build && electron-builder --win dir --publish never",
    "smoke": "electron-vite build && node tests/ui/m0-smoke.mjs",
    "test:replay": "node tests/ui/m1-replay.mjs",
    "test:app": "electron-vite build && node tests/ui/m1-app.mjs",
    "test:m2-app": "electron-vite build && node tests/ui/m2-app.mjs",
    "test:m2-replay": "node tests/ui/m2-replay.mjs",
    "test:m3-app": "electron-vite build && node tests/ui/m3-app.mjs",
    "test:m3-replay": "node tests/ui/m3-replay.mjs",
    "test:m4-app": "electron-vite build && node tests/ui/m4-app.mjs",
    "test:m4-replay": "node tests/ui/m4-replay.mjs",
    "test:m5-app": "electron-vite build && node tests/ui/m5-app.mjs",
    "test:m5-replay": "node tests/ui/m5-replay.mjs",
    "test:m6-app": "electron-vite build && node tests/ui/m6-app-settings.mjs && node tests/ui/m6-app-tools.mjs && node tests/ui/m6-app-slash.mjs",
    "test:m6-replay": "node tests/ui/m6-replay.mjs",
    "check": "npm run typecheck && node tests/check.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@pierre/diffs": "1.5.2",
    "@streamdown/code": "2.0.0",
    "koffi": "3.3.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.5.0",
    "streamdown": "2.7.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.0",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
